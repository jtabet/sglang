# Kvarn standalone image.
#
# FROM source is overridable so CI can build against the private registry copy
# of the base instead of Docker Hub:
#   docker build --build-arg BASE_IMAGE=registry.gitlab.com/orchestrel-ai/sglang:base ...
# Default (GitHub CI / local builds) keeps using the Docker Hub base.
ARG BASE_IMAGE=jtabet/sglang:kvarn-latest
FROM ${BASE_IMAGE}

# Upgrade flashinfer to 0.6.18 to satisfy the upstream version check
# (the base image ships 0.6.17, but the merged upstream requires >= 0.6.18).
# Also upgrade sglang-kernel to 0.4.7 for the same reason.
# flashinfer-cubin 0.6.18 is not on PyPI (max 0.6.17 in the base image), so
# we set FLASHINFER_DISABLE_VERSION_CHECK=1 to bypass the cubin version check
# -- the cubins are compatible between minor patch versions.
RUN pip install --no-cache-dir 'flashinfer-python[cu13]==0.6.18' sglang-kernel==0.4.7
ENV FLASHINFER_DISABLE_VERSION_CHECK=1

# Update Python source in-place (editable install -- no recompile needed)
COPY python/ /sgl-workspace/sglang/python/
COPY test/ /sgl-workspace/sglang/test/

# Build the Rust gateway binary from source (the base image's binary
# may not have the TTFT budget gate features we need).
COPY sgl-model-gateway/ /sgl-workspace/sglang/sgl-model-gateway/
RUN cd /sgl-workspace/sglang/sgl-model-gateway && \
    cargo build --release --bin sgl-model-gateway && \
    cp target/release/sgl-model-gateway /usr/local/bin/sgl-model-gateway && \
    rm -rf target