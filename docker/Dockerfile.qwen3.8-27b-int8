# Registry-driven variant: standalone image built in CI (registry.gitlab.com/
# orchestrel-ai/sglang:kvarn-standalone) + Qwen3.8-27B INT8 (W8A8) weights baked in.
#
# The image ships with the model in /models/Qwen3.8-27B-INT8-W8A8 so a container
# can run inference fully offline, e.g.:
#   python -m sglang.launch_server --model-path /models/Qwen3.8-27B-INT8-W8A8
#
# Build context = repo root (same as the other kvarn Dockerfiles).
# This path matches every existing burst/rancher template
# (--model-path /models/Qwen3.8-27B-INT8-W8A8), so a baked image is a
# drop-in replacement for `kvarn-standalone` in those templates.
#
# NOTE: only the shards referenced by model.safetensors.index.json are
# downloaded (~30.4 GB: two weight shards + mtp.safetensors). The hub repo
# has no unreferenced weight files, so nothing is skipped here.
FROM registry.gitlab.com/orchestrel-ai/sglang:kvarn-standalone

ENV HF_HOME=/hfcache

RUN mkdir -p /models/Qwen3.8-27B-INT8-W8A8 /hfcache && python - <<'PYEOF'
import json
import urllib.request

from huggingface_hub import snapshot_download

ORG, NAME = "Avesed", "Qwen3.8-27B-INT8-W8A8"
url = f"https://huggingface.co/{ORG}/{NAME}/resolve/main/model.safetensors.index.json"
idx = json.load(urllib.request.urlopen(url, timeout=60))
needed = sorted(set(idx["weight_map"].values()))
print(f"index references {len(needed)} files: {needed}")

snapshot_download(
    repo_id=f"{ORG}/{NAME}",
    allow_patterns=[
        *needed,
        "config.json",
        "generation_config.json",
        "chat_template.jinja",
        "preprocessor_config.json",
        "video_preprocessor_config.json",
        "tokenizer.json",
        "tokenizer_config.json",
        "merges.txt",
        "vocab.json",
        "model.safetensors.index.json",
    ],
    local_dir="/models/Qwen3.8-27B-INT8-W8A8",
)
print("download complete")
PYEOF

RUN du -sh /models/Qwen3.8-27B-INT8-W8A8 && python - <<'PYEOF'
import json, os

d = "/models/Qwen3.8-27B-INT8-W8A8"
idx = json.load(open(os.path.join(d, "model.safetensors.index.json")))
missing = [f for f in set(idx["weight_map"].values()) if not os.path.exists(os.path.join(d, f))]
assert not missing, f"missing shards: {missing}"
print("all shards present, model dir ready")
PYEOF